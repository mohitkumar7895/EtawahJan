# ImageKit — server-side upload (announcement images) + browser video upload
# Dashboard: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx
# Required for announcement videos: browser uploads directly to ImageKit (avoids 413 body limits on Vercel/nginx).
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx

# Optional: URL transformations in the browser
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# remove.bg — photo background removal (https://www.remove.bg/api)
# First 50 API calls/month are free. Get key: https://www.remove.bg/dashboard#api-key
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

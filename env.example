# Copy this file to .env.local and add your actual values
# Or copy from backend/.env if you have it there

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=

# ============================================
# EMAIL CONFIGURATION - Choose ONE option:
# ============================================

# OPTION 1: Resend (Recommended for production)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=

# OPTION 2: Gmail SMTP (Easier to set up)
# Your Gmail address
GMAIL_USER=your-email@gmail.com
# Gmail App Password (NOT your regular password!)
# Generate from: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-char-app-password

# ============================================
# Email Settings (Optional)
# ============================================

# From email address - must be verified in Resend dashboard (if using Resend)
# Format: "Display Name <email@domain.com>" or just "email@domain.com"
# Default: "Jun Seva Kendra <onboarding@resend.dev>"
FROM_EMAIL=

# Recipient emails (Optional)
# Comma-separated list of emails to receive form submissions
# Default: "dhaniramsingh711@gmail.com,mohitporwal596@gmail.com"
RECIPIENT_EMAILS=

